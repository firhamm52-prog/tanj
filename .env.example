# Copy to .env. Local demo defaults are enabled only outside production.
NODE_ENV=development
PORT=3000
AUTH_PORT=4001
CATALOG_PORT=4002
CONTENT_PORT=4003
HOST=127.0.0.1
ADMIN_EMAIL=admin@tanj.test
ADMIN_PASSWORD=demo123
# Set a random secret of at least 32 characters before production.
INTERNAL_SECRET=
# Production must use HTTPS (reverse proxy), and a password of at least 12 characters.
# NODE_ENV=production
# HOST=0.0.0.0

# Biteship configuration for the shipping integration.
# Keep the API key in .env only; never put it in web/ files.
BITESHIP_API_KEY=

# Midtrans Snap server settings (set actual values in Supabase Secrets).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Enable only after installing the migration, function and notification URL.
MIDTRANS_ENABLED=false
BITESHIP_ORIGIN_POSTAL_CODE=13110
# Use only couriers enabled for your Biteship account.
BITESHIP_COURIERS=jne,jnt
# Estimated packed weight per item, in grams.
BITESHIP_CLOTHING_WEIGHT_GRAMS=1000
BITESHIP_HIJAB_WEIGHT_GRAMS=300

# Server-only Supabase service_role/secret key for storing shipping quotes.
SUPABASE_SERVICE_ROLE_KEY=
