{
  "name": "tanj-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write . && node scripts/format-sql.mjs",
    "format:check": "prettier --check . && node scripts/format-sql.mjs --check",
    "start": "node scripts/start.mjs",
    "db:init": "node scripts/init-db.mjs",
    "admin:reset-password": "node scripts/reset-password.mjs",
    "test": "node --test tests/api.test.mjs",
    "test:ui": "node tests/browser.mjs",
    "test:payments": "node tests/manual-payments.mjs",
    "test:checkout": "node tests/checkout-experience.mjs",
    "test:commerce": "node scripts/test-commerce.mjs",
    "build:supabase": "node scripts/build-supabase.mjs",
    "test:supabase": "node tests/supabase-database.mjs && node tests/supabase-customer.mjs",
    "test:shopping": "node tests/shopping-improvements.mjs",
    "test:cms": "node tests/cloud-cms-database.mjs && node tests/cloud-cms-browser.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "sql-formatter": "^15.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
